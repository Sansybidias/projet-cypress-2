pipeline {
    agent {
        docker {
            image 'cypress/included:14.5.4'
            args '-u=root --entrypoint='
            }
    }

    stages {
        stage('installation les dependances') {
            steps {
                sh 'npm install'
            }
        }
         stage('lancement de test') {
            steps {
                sh 'npx cypress run'
                
            }
        }
    }
}
